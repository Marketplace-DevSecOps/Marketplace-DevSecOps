# Copy to backend/.env and adjust. Never commit backend/.env.
# Values below are non-secret local defaults for development only.

# --- Application ---
NODE_ENV=development
PORT=3000
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Comma-separated list of allowed Web origins (no wildcard).
CORS_ORIGINS=http://localhost:5173
# Express "trust proxy" value: false, true, a hop count (e.g. 1),
# or a comma-separated list of trusted addresses/subnets.
# "true" is rejected when NODE_ENV=production.
TRUST_PROXY=false
# Maximum JSON body size (at most 64kb; larger values are rejected).
BODY_LIMIT=64kb

# --- PostgreSQL (used by docker-compose.yml) ---
POSTGRES_USER=marketplace
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=marketplace_dev
POSTGRES_TEST_DB=marketplace_test
# Host ports; change them (and the URLs below) if 5432/5433 are already in use.
POSTGRES_PORT=5432
POSTGRES_TEST_PORT=5433

# --- Database URLs (must match the values above) ---
# DATABASE_URL is used by the app and the Prisma CLI (migrate, seed).
# DATABASE_URL_TEST is used by tests (NODE_ENV=test) and `npm run test:db`,
# which reset that database only (`npm test` resets it once per run). It must
# differ from DATABASE_URL, point to localhost/127.0.0.1/::1/db-test and have
# a database name containing "test"; anything else is refused.
# Least-privilege app role (marketplace_app) vs migration role:
# see docs/backend/db-roles.md and prisma/sql/app-role.sql.
DATABASE_URL=postgresql://marketplace:change-me-local-only@localhost:5432/marketplace_dev
DATABASE_URL_TEST=postgresql://marketplace:change-me-local-only@localhost:5433/marketplace_test
