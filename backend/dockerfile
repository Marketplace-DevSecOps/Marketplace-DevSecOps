FROM node:24-bookworm-slim

WORKDIR /app

RUN apt-get update && apt-get install -y openssl ca-certificates

COPY package.json package-lock.json ./
COPY prisma.config.ts ./
COPY prisma/ ./prisma/

RUN npm ci

COPY . .

RUN npm run prisma:generate

RUN npm run build

EXPOSE 3000

CMD ["node", "dist/server.js"]