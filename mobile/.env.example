# Public configuration only. Never put access/refresh tokens or passwords here.
# No fallback: real mode requires a valid URL and never returns mock data.
EXPO_PUBLIC_API_MODE=real
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1
EXPO_PUBLIC_API_TIMEOUT_MS=15000
# Local/private IP HTTP only, and only in an Expo development build.
EXPO_PUBLIC_ALLOW_LOCAL_HTTP=true

# Offline fictional services: change EXPO_PUBLIC_API_MODE to mock.
# URL is ignored in mock mode. Every screen then displays the mock notice.
